# SMTP za kontakt formu.
# Faza 1: šalje se kroz postojeći timis.digital sandučić (SPF/DKIM već postoje).
# Kasnije, kad mojacijena.hr dobije mail: zamijeniti s info@mojacijena.hr.
SMTP_HOST=mail.your-server.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=igor@timis.digital
SMTP_PASS=
MAIL_FROM=igor@timis.digital
MAIL_TO=igor@timis.digital
