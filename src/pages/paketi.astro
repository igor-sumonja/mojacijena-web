---
import Base from '../layouts/Base.astro';
import PriceCards from '../components/PriceCards.astro';
import UkljucenjeIPretplata from '../components/UkljucenjeIPretplata.astro';
import Cta from '../components/Cta.astro';
import { noviWeb, glavni, besplatno, dodatakPromjene, trgovine, eur } from '../data/paketi';

const stupci = ['Besplatno', glavni.naziv, noviWeb.naziv];

const redovi: [string, (boolean | string)[]][] = [
  ['Portal za unos cijena, bez lozinke', [true, true, true]],
  ['Preuzimanje XML, CSV i PDF datoteke', [true, true, true]],
  ['Javni cjenik i QR na mojacijena.hr', [true, true, true]],
  ['Tablica cijena za letke i oglase', [true, true, true]],
  ['Automatska objava, bez ručnog skidanja', [false, true, true]],
  ['Cjenik i arhiva na vašoj domeni', [false, true, true]],
  ['Postavljanje i prvi unos radimo mi', [false, true, true]],
  ['Dnevna objava i objava kod svake promjene', [false, true, true]],
  [`Dodatak „${dodatakPromjene.naziv}” (+ ${eur(dodatakPromjene.cijenaGod)}/god)`, [false, 'dodatak', 'dodatak']],
  ['Izrada nove web stranice, do 5 stranica', [false, false, true]],
  ['Hosting i domena', [false, false, true]],
  ['Sitne izmjene teksta na stranici', [false, false, true]],
];
---
<Base title="Paketi i cijene" description="Jedan godišnji iznos po paketu. Besplatni PDF i QR za lokal, cjenik objavljen na vašoj domeni, ili izrada novog weba s ugrađenim cjenikom.">
  <section class="container-x flex flex-col gap-4 py-16 sm:py-20">
    <p class="eyebrow">Paketi i cijene</p>
    <h1 class="max-w-[800px] text-4xl sm:text-5xl">Jedan godišnji iznos, bez skrivenih troškova</h1>
    <p class="max-w-[680px] text-lg text-ink-2">Naplaćujemo rad, integraciju i odgovornost. Promjene cijena ne naplaćujemo ni u jednom paketu. Sve cijene su bez PDV-a.</p>
  </section>

  <section class="section section-white">
    <div class="container-x flex flex-col gap-12">
      <PriceCards trgovineTraka={false} />
      <UkljucenjeIPretplata />
    </div>
  </section>

  <section class="section">
    <div class="container-x flex flex-col gap-8">
      <h2 class="text-3xl">Što je točno uključeno</h2>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] border-collapse text-left">
          <thead>
            <tr class="border-b-2 border-ink">
              <th class="py-3 pr-4 font-semibold">Stavka</th>
              {stupci.map((n) => <th class="py-3 px-4 font-semibold">{n}</th>)}
            </tr>
          </thead>
          <tbody>
            {redovi.map(([n, v]) => (
              <tr class="border-b border-line">
                <td class="py-3 pr-4 text-ink-2">{n}</td>
                {v.map((x) => <td class="py-3 px-4">{x === true ? <span class="font-semibold text-accent">✓</span> : x === false ? <span class="text-sand">–</span> : <span class="text-[15px] text-muted">{x}</span>}</td>)}
              </tr>
            ))}
            <tr class="border-b border-line bg-paper-2">
              <td class="py-3 pr-4 font-semibold">Prve godine</td>
              <td class="py-3 px-4 font-semibold">0 €</td>
              <td class="py-3 px-4 font-semibold">{eur(glavni.prvaGodina)}</td>
              <td class="py-3 px-4 font-semibold">{eur(noviWeb.prvaGodina)}</td>
            </tr>
            <tr class="bg-paper-2">
              <td class="py-3 pr-4 font-semibold">Svake sljedeće</td>
              <td class="py-3 px-4 font-semibold">0 €</td>
              <td class="py-3 px-4 font-semibold">{eur(glavni.obnova)}</td>
              <td class="py-3 px-4 font-semibold">{eur(noviWeb.obnova)}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[14px] text-muted">{besplatno.ograda}</p>
      <div class="flex flex-col gap-3 rounded-lg border border-line bg-white px-7 py-6">
        <div class="text-lg font-semibold">{trgovine.naslov}</div>
        <p class="max-w-[760px] text-ink-2">{trgovine.tekst}</p>
        <a href="/kontakt?paket=trgovina" class="btn-secondary self-start">Zatražite individualnu ponudu</a>
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="flex flex-col gap-4 lg:col-span-5">
        <h2 class="text-3xl">{noviWeb.naziv}, detaljnije</h2>
        <p class="text-lg text-ink-2">Za obrte koji nemaju web ili im je stranica zastarjela, na Wixu ili kod agencije koja više ne odgovara. Umjesto da cjenik lijepimo na stranicu na koju nemamo pristup, napravimo novu na kojoj je ugrađen od prvog dana. Postojeću stranicu možemo i preseliti k nama.</p>
        <div class="flex items-baseline gap-2"><span class="font-serif text-4xl font-semibold">{eur(noviWeb.prvaGodina)}</span><span class="text-muted">prve godine</span><span class="ml-3 text-xl font-semibold">{eur(noviWeb.obnova)}</span><span class="text-muted">svake sljedeće</span></div>
      </div>
      <div class="flex flex-col gap-4 lg:col-span-7">
        <ul class="flex flex-col gap-2 text-ink-2">
          {['Do 5 stranica na jednom od naših predložaka', 'Vi dostavljate tekst i fotografije, jedan krug izmjena', 'Isporuka u 10 radnih dana od dostave materijala', 'Obnova pokriva hosting, domenu, cjenik, promjene cijena i sitne izmjene teksta', 'Sve iz paketa „Cjenik na vašem webu”'].map((t) => <li class="flex gap-2.5"><span class="font-semibold text-accent" aria-hidden="true">✓</span><span>{t}</span></li>)}
        </ul>
        <p class="text-[15px] text-muted">Napomena: ako danas nemate web stranicu, nemate ni obvezu objave cjenika. Izradom weba obveza nastaje. Isporuka od listopada 2026.</p>
        <a href="/kontakt?paket=novi-web" class="btn-secondary self-start">Naručite</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5"><h2 class="text-3xl">Otkaz</h2></div>
      <div class="prose-x text-lg text-ink-2 lg:col-span-7">
        <p>Obnovu možete otkazati bilo kad, bez otkaznog roka; već objavljene datoteke ostaju u arhivi.</p>
        <p>Godišnji iznos plaća se unaprijed, jedan račun godišnje. Može i mjesečno. Promjene cijena ne naplaćujemo ni u jednom paketu.</p>
      </div>
    </div>
  </section>
  <Cta />
</Base>
