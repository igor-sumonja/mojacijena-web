---
import Base from '../layouts/Base.astro';
import PriceCards from '../components/PriceCards.astro';
import Cta from '../components/Cta.astro';
import { paketi, noviWeb, trgovine, eur } from '../data/paketi';

const redovi: [string, (boolean | string)[]][] = [
  ['Cjenik u XML i CSV obliku, na vašoj domeni', [true, true, true]],
  ['Sidrene cijene uz cijene na vašem webu', [true, true, true]],
  ['Unos početnog cjenika i spremanje dokaza', [true, true, true]],
  ['Portal za promjene s telefona, bez lozinke', [true, true, true]],
  ['Trajna arhiva svih objava', [true, true, true]],
  ['PDF cjenik za pult i QR kod', [true, true, true]],
  ['Prilagodba kad se propis promijeni', [true, true, true]],
  ['Promjene javljate porukom, mi unosimo', [false, true, true]],
  ['Objava isti dan nakon vaše poruke', [false, true, true]],
  ['Mjesečni izvještaj o objavama', [false, true, true]],
  ['Tablica cijena za letke i oglase', [false, true, true]],
  ['Izrada nove web stranice, do 5 stranica', [false, false, true]],
  ['Hosting i domena', [false, false, true]],
  ['Sitne izmjene teksta na stranici', [false, false, true]],
];
---
<Base title="Paketi i cijene" description="Jednokratno uključenje i mjesečna pretplata. Dva paketa za postojeće web stranice, izrada novog weba s ugrađenim cjenikom i individualna ponuda za veće trgovine.">
  <section class="container-x flex flex-col gap-4 py-16 sm:py-20">
    <p class="eyebrow">Paketi i cijene</p>
    <h1 class="max-w-[800px] text-4xl sm:text-5xl">Jednokratno uključenje i mjesečna pretplata</h1>
    <p class="max-w-[680px] text-lg text-ink-2">Naplaćujemo rad, integraciju i odgovornost. Promjene cijena ne naplaćujemo ni u jednom paketu. Sve cijene su bez PDV-a.</p>
  </section>

  <section class="section section-white">
    <div class="container-x flex flex-col gap-12">
      <PriceCards trgovineTraka={false} />
      <div class="grid gap-8 border-t border-line pt-10 lg:grid-cols-2">
        <div class="flex flex-col gap-3">
          <h2 class="text-2xl">Što plaćate kod uključenja</h2>
          <p class="text-ink-2">Uključenje je jednokratni posao kojim vaš cjenik prvi put dovedemo u red: spojimo sustav s vašom web stranicom, unesemo sve usluge ili artikle s cijenama i sidrenim cijenama, spremimo dokaze o cijenama i objavimo prvi cjenik u obliku koji propis traži. To je najveći dio posla i plaća se jednom, prije početka rada.</p>
        </div>
        <div class="flex flex-col gap-3">
          <h2 class="text-2xl">Što pokriva pretplata</h2>
          <p class="text-ink-2">Da sve to ostane uredno i sutra: objave i trajna arhiva kao dokaz da je cjenik bio dostupan, promjene cijena bez naplate, prilagodba kad se propis promijeni i netko koga možete nazvati kad nešto nije jasno.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x flex flex-col gap-8">
      <h2 class="text-3xl">Što je točno uključeno</h2>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] border-collapse text-left">
          <thead>
            <tr class="border-b-2 border-ink">
              <th class="py-3 pr-4 font-semibold">Stavka</th>
              {paketi.map((p) => <th class="py-3 px-4 font-semibold">{p.naziv}</th>)}
            </tr>
          </thead>
          <tbody>
            {redovi.map(([n, v]) => (
              <tr class="border-b border-line">
                <td class="py-3 pr-4 text-ink-2">{n}</td>
                {v.map((x) => <td class="py-3 px-4">{x === true ? <span class="font-semibold text-accent">✓</span> : x === false ? <span class="text-sand">–</span> : <span class="text-[15px] text-muted">{x}</span>}</td>)}
              </tr>
            ))}
            <tr class="border-b border-line bg-paper-2">
              <td class="py-3 pr-4 font-semibold">Uključenje</td>
              {paketi.map((p) => <td class="py-3 px-4 font-semibold">{eur(p.ukljucenje)}</td>)}
            </tr>
            <tr class="bg-paper-2">
              <td class="py-3 pr-4 font-semibold">Mjesečno</td>
              {paketi.map((p) => <td class="py-3 px-4 font-semibold">{eur(p.mjesecno)}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
      <div class="flex flex-col gap-3 rounded-lg border border-line bg-white px-7 py-6">
        <div class="text-lg font-semibold">{trgovine.naslov}</div>
        <p class="max-w-[760px] text-ink-2">{trgovine.tekst}</p>
        <a href="/kontakt?paket=trgovina" class="btn-secondary self-start">Zatražite individualnu ponudu</a>
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="flex flex-col gap-4 lg:col-span-5">
        <h2 class="text-3xl">{noviWeb.naziv}, detaljnije</h2>
        <p class="text-lg text-ink-2">Za obrte koji nemaju web ili im je stranica zastarjela, na Wixu ili kod agencije koja više ne odgovara. Umjesto da cjenik lijepimo na stranicu na koju nemamo pristup, napravimo novu na kojoj je ugrađen od prvog dana. Postojeću stranicu možemo i preseliti k nama.</p>
        <div class="flex items-baseline gap-2"><span class="font-serif text-4xl font-semibold">{eur(noviWeb.ukljucenje)}</span><span class="text-muted">uključenje</span><span class="ml-3 text-xl font-semibold">+ {eur(noviWeb.mjesecno)}</span><span class="text-muted">mjesečno</span></div>
      </div>
      <div class="flex flex-col gap-4 lg:col-span-7">
        <ul class="flex flex-col gap-2 text-ink-2">
          {['Do 5 stranica na jednom od naših predložaka', 'Vi dostavljate tekst i fotografije, jedan krug izmjena', 'Isporuka u 10 radnih dana od dostave materijala', 'Mjesečno pokriva hosting, domenu, cjenik, promjene cijena i sitne izmjene teksta', 'Sve iz paketa Bez brige'].map((t) => <li class="flex gap-2.5"><span class="font-semibold text-accent" aria-hidden="true">✓</span><span>{t}</span></li>)}
        </ul>
        <p class="text-[15px] text-muted">Napomena: ako danas nemate web stranicu, nemate ni obvezu objave cjenika. Izradom weba obveza nastaje. Isporuka od listopada 2026.</p>
        <a href="/kontakt?paket=novi-web" class="btn-secondary self-start">Zatražite ponudu</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5"><h2 class="text-3xl">Otkaz</h2></div>
      <div class="prose-x text-lg text-ink-2 lg:col-span-7">
        <p>Pretplatu možete otkazati bilo kad, bez otkaznog roka; već objavljene datoteke ostaju u arhivi.</p>
        <p>Pretplata se u pravilu plaća godišnje unaprijed: 10 mjeseci za 12 i jedan račun godišnje. Može i mjesečno. Promjene cijena ne naplaćujemo ni u jednom paketu.</p>
      </div>
    </div>
  </section>
  <Cta />
</Base>
