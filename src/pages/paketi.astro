---
import Base from '../layouts/Base.astro';
import PriceCards from '../components/PriceCards.astro';
import Cta from '../components/Cta.astro';
import { paketi, kombo, eur } from '../data/paketi';

const redovi: [string, (boolean | string)[]][] = [
  ['Cjenik u XML i CSV obliku, na vašoj domeni', [true, true, true]],
  ['Sidrene cijene uz cijene na vašem webu', [true, true, true]],
  ['Unos početnog cjenika i spremanje dokaza', [true, true, true]],
  ['Portal za promjene s telefona, bez lozinke', [true, true, true]],
  ['Trajna arhiva svih objava', [true, true, true]],
  ['PDF cjenik za pult i QR kod', [true, true, true]],
  ['Promjene javljate porukom, mi unosimo', [false, true, true]],
  ['Objava isti dan nakon vaše poruke', [false, true, true]],
  ['Mjesečni izvještaj o objavama', [false, true, true]],
  ['Tablica cijena za letke i oglase', [false, true, true]],
  ['Prilagodba kad se propis promijeni', [true, true, true]],
  ['Automatska objava svako jutro, i vikendom', [false, false, true]],
  ['Više prodajnih objekata', [false, false, true]],
  ['Uvoz artikala iz Excela ili CSV-a', [false, false, true]],
  ['Akcije s najnižom cijenom u 30 dana', [false, false, true]],
];
---
<Base title="Paketi i cijene" description="Jednokratno uključenje i mjesečna pretplata. Tri paketa za obrte i trgovine, kombo s novim webom i besplatna varijanta za one koji žele sve sami.">
  <section class="container-x flex flex-col gap-4 py-16 sm:py-20">
    <p class="eyebrow">Paketi i cijene</p>
    <h1 class="max-w-[800px] text-4xl sm:text-5xl">Jednokratno uključenje i mjesečna pretplata</h1>
    <p class="max-w-[680px] text-lg text-ink-2">Broj stavki nije ograničen ni u jednom paketu. Naplaćujemo rad, integraciju i odgovornost, ne broj redaka u cjeniku. Sve cijene su bez PDV-a.</p>
  </section>

  <section class="section section-white">
    <div class="container-x"><PriceCards /></div>
  </section>

  <section class="section">
    <div class="container-x flex flex-col gap-8">
      <h2 class="text-3xl">Što je točno uključeno</h2>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] border-collapse text-left">
          <thead>
            <tr class="border-b-2 border-ink">
              <th class="py-3 pr-4 font-semibold">Stavka</th>
              {paketi.map((p) => <th class="py-3 px-4 font-semibold">{p.naziv}</th>)}
            </tr>
          </thead>
          <tbody>
            {redovi.map(([n, v]) => (
              <tr class="border-b border-line">
                <td class="py-3 pr-4 text-ink-2">{n}</td>
                {v.map((x) => <td class="py-3 px-4">{x === true ? <span class="font-semibold text-accent">✓</span> : x === false ? <span class="text-sand">–</span> : <span class="text-[15px] text-muted">{x}</span>}</td>)}
              </tr>
            ))}
            <tr class="border-b border-line bg-paper-2">
              <td class="py-3 pr-4 font-semibold">Uključenje</td>
              {paketi.map((p) => <td class="py-3 px-4 font-semibold">{eur(p.ukljucenje)}</td>)}
            </tr>
            <tr class="bg-paper-2">
              <td class="py-3 pr-4 font-semibold">Mjesečno</td>
              {paketi.map((p) => <td class="py-3 px-4 font-semibold">{eur(p.mjesecno)}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div class="flex flex-col gap-4">
        <h2 class="text-3xl">{kombo.naziv}</h2>
        <p class="text-lg text-ink-2">Za obrte koji nemaju web ili im je stranica zastarjela, na Wixu ili kod agencije koja više ne odgovara. Umjesto da cjenik lijepimo na stranicu na koju nemamo pristup, napravimo novu na kojoj je ugrađen od prvog dana.</p>
        <div class="flex items-baseline gap-2"><span class="font-serif text-4xl font-semibold">{eur(kombo.ukljucenje)}</span><span class="text-muted">uključenje</span><span class="ml-3 text-xl font-semibold">+ {eur(kombo.mjesecno)}</span><span class="text-muted">mjesečno</span></div>
        <ul class="flex flex-col gap-2 text-ink-2">
          {['Do 5 stranica na jednom od naših predložaka', 'Vi dostavljate tekst i fotografije, jedan krug izmjena', 'Isporuka u 10 radnih dana od dostave materijala', 'Mjesečno pokriva hosting, domenu, cjenik, promjene cijena i sitne izmjene teksta', 'Sve iz paketa Bez brige'].map((t) => <li class="flex gap-2.5"><span class="font-semibold text-accent" aria-hidden="true">✓</span><span>{t}</span></li>)}
        </ul>
        <p class="text-[15px] text-muted">Napomena: ako danas nemate web stranicu, nemate ni obvezu objave cjenika. Izradom weba obveza nastaje. Isporuka od listopada 2026.</p>
        <a href="/kontakt?paket=novi-web" class="btn-secondary self-start">Zatražite ponudu</a>
      </div>
      <div class="flex flex-col gap-4">
        <h2 class="text-3xl">Želite sve sami? Besplatno.</h2>
        <p class="text-lg text-ink-2">Portal u koji sami unosite cijene, s cjenikom, PDF-om i QR kodom na našoj domeni. Bez našeg unosa, bez spajanja s vašim webom i bez podrške. Isto što nude besplatna rješenja, kod nas s mogućnošću da kasnije pređete na paket s cjenikom na vlastitom webu bez ponovnog unosa.</p>
        <p class="text-[15px] text-muted">Cjenik na tuđoj domeni pravno je slabija varijanta od datoteke na vašoj adresi. Zato je besplatan.</p>
        <a href="/kontakt?paket=besplatno" class="btn-secondary self-start">Otvorite besplatni portal</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5"><h2 class="text-3xl">Jamstvo i otkaz</h2></div>
      <div class="prose-x text-lg text-ink-2 lg:col-span-7">
        <p>Ako Vlada ukine obvezu ili vaša djelatnost bude izuzeta prije 31. 12. 2026., vraćamo vam uplaćeno uključenje. Pretplatu možete otkazati bilo kad; već objavljene datoteke ostaju u arhivi.</p>
        <p>Kod godišnjeg plaćanja unaprijed plaćate 10 mjeseci za 12. Promjene cijena ne naplaćujemo ni u jednom paketu.</p>
      </div>
    </div>
  </section>
  <Cta />
</Base>
