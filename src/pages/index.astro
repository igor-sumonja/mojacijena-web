---
import Base from '../layouts/Base.astro';
import PriceCards from '../components/PriceCards.astro';
import ContactForm from '../components/ContactForm.astro';
import { faq } from '../data/faq';
const topFaq = faq.filter((q) => q.landing);
---
<Base title="Cjenik na vašoj web stranici, u obliku koji propis traži" description="Od 1. listopada 2026. trgovci i pružatelji usluga s web stranicom moraju objaviti strojno čitljiv cjenik i istaknuti sidrenu cijenu. Postavimo to na vašem webu i održavamo dalje.">

  <!-- 1. Hero -->
  <section class="container-x grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-12">
    <div class="flex flex-col gap-6 lg:col-span-7">
      <p class="eyebrow flex items-center gap-2.5"><span class="inline-block h-2 w-2 rounded-full bg-accent"></span>Obveza od 1. listopada 2026.</p>
      <h1 class="text-4xl leading-[1.12] sm:text-5xl lg:text-[58px]">Cjenik na vašoj web stranici, u obliku koji propis traži</h1>
      <p class="max-w-[620px] text-lg text-ink-2 sm:text-xl">Postavimo ga na vašu postojeću stranicu i održavamo dalje — promjene, objave i prilagodbu propisu.</p>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <a href="/kontakt" class="btn-primary text-lg">Zatražite ponudu</a>
        <a href="#paketi" class="btn-secondary text-lg">Pogledajte pakete</a>
      </div>
      <p class="text-[15px] italic text-muted">Tehnički dio provodimo mi. Za točnost cijena i sadržaj cjenika odgovarate vi.</p>
    </div>
    <div class="lg:col-span-5 lg:justify-self-end">
      <div class="anim-float w-full max-w-[440px] overflow-hidden rounded-xl border border-line bg-white shadow-[0_24px_48px_rgba(28,34,41,0.08)]">
        <div class="flex h-10 items-center gap-2.5 bg-paper-2 px-4">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-cream"></span>
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-cream"></span>
          <div class="ml-2 flex h-[22px] flex-1 items-center rounded bg-white px-2.5 text-[13px] text-muted">frizerskisalon-ana.hr/cjenik/</div>
        </div>
        <div class="flex flex-col gap-3.5 px-7 py-6">
          <div class="font-serif text-xl font-semibold">Cjenik usluga</div>
          <dl class="border-t border-line-2">
            {[
              ['Šišanje, ženski', '22,00 €', '20,00 €'],
              ['Šišanje, muški', '14,00 €', '14,00 €'],
              ['Bojanje, kratka kosa', '45,00 €', '42,00 €'],
            ].map(([n, c, s]) => (
              <div class="flex items-start justify-between border-b border-line-2 py-3 text-base">
                <dt>{n}</dt>
                <dd class="flex flex-col items-end"><span class="font-semibold">{c}</span><span class="text-xs text-muted">cijena 10. 9. 2026.: {s}</span></dd>
              </div>
            ))}
          </dl>
          <div class="mt-1 flex flex-wrap gap-2.5">
            {['latest.csv', 'latest.xml', 'cjenik.pdf'].map((f) => <span class="rounded border border-accent px-2.5 py-1 text-[13px] font-semibold text-accent">{f}</span>)}
          </div>
          <p class="flex items-center gap-2 text-xs text-muted"><span class="anim-dot inline-block h-2 w-2 rounded-full bg-accent"></span>Zadnja objava: 1. 10. 2026. u 06:30. Arhiva svih objava.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Što propis traži -->
  <section class="section section-white">
    <div class="container-x flex flex-col gap-10">
      <p class="eyebrow">Što propis traži</p>
      <div class="grid gap-10 md:grid-cols-3">
        <div class="anim-rise flex flex-col gap-3 text-accent">
          <svg class="anim-draw" width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true"><rect x="7" y="4" width="22" height="28" rx="3" stroke="currentColor" stroke-width="2"/><path d="M15 15l-4 4 4 4M21 15l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h2 class="text-[21px] text-ink">Cjenik koji računalo može pročitati</h2>
          <p class="text-ink-2">Datoteka na vašoj adresi, javna i uvijek ažurna. Vi je ne morate razumjeti; izrađujemo je mi.</p>
        </div>
        <div class="anim-rise-2 flex flex-col gap-3 text-accent">
          <svg class="anim-draw" width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true"><circle cx="18" cy="7.5" r="3" stroke="currentColor" stroke-width="2"/><path d="M18 10.5V31M8 22c1.2 5.6 5.6 8 10 8s8.8-2.4 10-8M11.5 15.5h13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <h2 class="text-[21px] text-ink">Sidrena cijena uz svaku cijenu</h2>
          <p class="text-ink-2">Cijena od 10. rujna 2026., istaknuta uz redovnu. Za hranu, piće, kozmetiku i kućanstvo vrijedi 2. svibnja 2025.</p>
        </div>
        <div class="anim-rise-3 flex flex-col gap-3 text-accent">
          <svg class="anim-draw" width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true"><circle cx="18" cy="18" r="13" stroke="currentColor" stroke-width="2"/><path d="M18 11v7l5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h2 class="text-[21px] text-ink">Redovito ažuriranje</h2>
          <p class="text-ink-2">Usluge kod svake promjene, trgovine svako jutro do 8:00. Objave ostaju dostupne 30 dana.</p>
        </div>
      </div>
      <p class="text-[15px] text-muted">Za nepoštivanje su propisane kazne od 3.000 do 30.000 eura za trgovca i od 1.000 do 4.000 eura za odgovornu osobu. Izvori: <a href="https://narodne-novine.nn.hr/clanci/sluzbeni/2026_09_101_1213.html" rel="noopener">Odluka o objavi cjenika</a> i <a href="https://narodne-novine.nn.hr/clanci/sluzbeni/2026_09_101_1212.html" rel="noopener">Odluka o isticanju dodatne cijene</a>, NN 101/2026.</p>
    </div>
  </section>

  <!-- 3. Tri koraka -->
  <section id="kako" class="section scroll-mt-20">
    <div class="container-x flex flex-col gap-10">
      <h2 class="text-3xl sm:text-4xl">Tri koraka, a onda ide samo</h2>
      <div class="grid gap-10 md:grid-cols-3">
        <div class="anim-rise flex flex-col gap-3.5">
          <div class="flex items-center">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent font-serif text-[26px] font-semibold text-paper">1</div>
            <div class="ml-4 h-0.5 flex-1 bg-line"></div>
          </div>
          <h3 class="font-sans text-xl">Unesemo vaš cjenik</h3>
          <p class="-mt-1 text-ink-2">Iz Excela, papira ili fotografije starog cjenika — sa sidrenim cijenama i dokazima.</p>
        </div>
        <div class="anim-rise-2 flex flex-col gap-3.5">
          <div class="flex items-center">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent font-serif text-[26px] font-semibold text-paper">2</div>
            <div class="ml-4 h-0.5 flex-1 bg-line"></div>
          </div>
          <h3 class="font-sans text-xl">Spojimo ga s vašom stranicom</h3>
          <p class="-mt-1 text-ink-2">Pojavi se na vasadomena.hr/cjenik/ — vi na svom webu ne mijenjate ništa.</p>
        </div>
        <div class="anim-rise-3 flex flex-col gap-3.5">
          <div class="flex items-center">
            <div class="box-border flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-accent font-serif text-[26px] font-semibold text-accent">3</div>
            <div class="ml-4 text-[13px] font-semibold uppercase tracking-wider text-accent">Dalje ide samo</div>
          </div>
          <h3 class="font-sans text-xl">Dalje održavamo mi</h3>
          <p class="-mt-1 text-ink-2">Objave, arhiva, podsjetnici i prilagodba kad se propis promijeni.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Paketi -->
  <section id="paketi" class="section section-white scroll-mt-20">
    <div class="container-x flex flex-col gap-7">
      <h2 class="text-3xl sm:text-4xl">Jedno pitanje: tko mijenja cijene?</h2>
      <PriceCards trgovineTraka={false} />
      <div class="mx-auto max-w-[860px] rounded-lg border border-line bg-paper px-7 py-4 text-center text-[15px] leading-relaxed text-ink-2">
        <span class="font-semibold text-ink">Uključenje</span> plaćate jednom — to je posao postavljanja: spajanje s vašom stranicom, unos svih stavki sa sidrenim cijenama i prva objava. <span class="font-semibold text-ink">Pretplata</span> drži sve urednim dalje: objave, arhiva, promjene bez naplate i prilagodba propisu.
      </div>
      <p class="text-center text-[14px] text-muted">Trgovina s više od stotinjak artikala? Radimo individualnu ponudu — <a href="/kontakt?paket=trgovina" class="font-semibold">javite nam se</a>.</p>
      <p class="text-center text-[15px]"><a href="/paketi" class="font-semibold text-accent">Detaljna usporedba svega uključenog →</a></p>
    </div>
  </section>

  <!-- 5. Zašto kod nas -->
  <section class="container-x py-16 sm:py-20">
    <div class="grid gap-10 rounded-2xl bg-ink px-7 py-10 text-paper sm:px-12 sm:py-14 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col gap-3 text-cream">
        <svg class="anim-draw" width="32" height="32" viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M5 16L18 5l13 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 14.5V31h18V14.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M15 31v-8h6v8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <h2 class="text-2xl text-paper sm:text-[26px]">Na vašoj adresi, ne na tuđoj</h2>
        <p class="text-cream">Besplatna rješenja drže cjenik na tuđoj domeni. Propis govori o objavi na vašim stranicama — kod nas datoteke stoje na vašoj adresi.</p>
      </div>
      <div class="flex flex-col gap-3 text-cream">
        <svg class="anim-draw" width="32" height="32" viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M18 4l11 4v9c0 7-4.6 11.9-11 15C11.6 28.9 7 24 7 17V8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M13 18l3.5 3.5L24 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h2 class="text-2xl text-paper sm:text-[26px]">Propis se mijenja, vaši podaci ostaju</h2>
        <p class="text-cream">Od 17. studenoga obveza postaje trajna, a pravila će se mijenjati. Prilagodbu radimo mi, unutar pretplate, bez ponovnog unosa.</p>
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="section section-white">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="flex flex-col gap-4 lg:col-span-3">
        <h2 class="text-3xl leading-tight">Tri najčešća pitanja</h2>
        <p class="text-[15px]"><a href="/pitanja" class="font-semibold text-accent">Sva pitanja →</a></p>
      </div>
      <div class="grid gap-8 md:grid-cols-3 lg:col-span-9">
        {topFaq.map((q) => (
          <div class="flex flex-col gap-2.5 border-t-2 border-ink pt-4">
            <h3 class="font-sans text-lg">{q.q}</h3>
            <p class="text-[15.5px] text-ink-2">{q.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Kontakt -->
  <section id="kontakt" class="section scroll-mt-20">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="flex flex-col gap-4 lg:col-span-5">
        <p class="eyebrow">Kontakt</p>
        <h2 class="text-3xl sm:text-4xl">Zatražite ponudu</h2>
        <p class="text-lg text-ink-2">Odgovor u roku 24 sata. Ivanić-Grad i okolica: po potrebi dolazimo i na teren.</p>
        <address class="mt-3 flex flex-col gap-1 not-italic text-ink-2">
          <span class="font-semibold text-ink">Timis Digital d.o.o.</span>
          <span>Ivanićgradska ulica 33, 10310 Ivanić-Grad</span>
          <span><a href="tel:+385915882884">091 588 2884</a>, <a href="mailto:igor@timis.digital">igor@timis.digital</a></span>
        </address>
      </div>
      <div class="lg:col-span-7"><ContactForm /></div>
    </div>
  </section>
</Base>
