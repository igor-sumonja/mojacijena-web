---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { faq } from '../data/faq';
const grupe = ['Obveza', 'Kako radi', 'Naša usluga', 'Ugovor i plaćanje'] as const;
---
<Base title="Česta pitanja" description="Odgovori na pitanja o sidrenoj cijeni, strojno čitljivom cjeniku, našoj usluzi, ugovoru i plaćanju.">
  <section class="container-x flex flex-col gap-4 py-16 sm:py-20">
    <p class="eyebrow">Česta pitanja</p>
    <h1 class="text-4xl sm:text-5xl">Pitanja i odgovori</h1>
    <nav class="mt-2 flex flex-wrap gap-2" aria-label="Skupine pitanja">
      {grupe.map((g) => <a href={`#${g.toLowerCase().replace(/[^a-z]+/g, '-')}`} class="rounded-full border border-line bg-white px-4 py-2 text-[15px] text-ink no-underline hover:border-ink">{g}</a>)}
    </nav>
  </section>
  <section class="section section-white">
    <div class="container-x mx-auto flex max-w-[860px] flex-col gap-14">
      {grupe.map((g) => (
        <div id={g.toLowerCase().replace(/[^a-z]+/g, '-')} class="flex flex-col gap-2 scroll-mt-20">
          <h2 class="mb-3 text-3xl">{g}</h2>
          {faq.filter((q) => q.grupa === g).map((q) => (
            <details class="group border-b border-line py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-xl font-semibold">
                <span>{q.q}</span>
                <svg class="mt-1.5 shrink-0 transition-transform group-open:rotate-45" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </summary>
              <p class="mt-3 max-w-[720px] text-ink-2">{q.a}</p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>
  <Cta title="Niste našli odgovor?" text="Pišite nam ili zatražite ponudu; odgovor u roku 24 sata." />
</Base>
