---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
const paket = Astro.url.searchParams.get('paket') ?? '';
export const prerender = false;
---
<Base title="Kontakt" description="Zatražite ponudu za cjenik na vašoj web stranici. Javimo se u jednom radnom danu.">
  <section class="container-x grid gap-10 py-16 sm:py-20 lg:grid-cols-12">
    <div class="flex flex-col gap-4 lg:col-span-5">
      <p class="eyebrow">Kontakt</p>
      <h1 class="text-4xl sm:text-5xl">Zatražite ponudu</h1>
      <p class="text-lg text-ink-2">Javimo se u jednom radnom danu s ponudom i pitanjima o vašem webu. Ivanić-Grad i okolica: po potrebi dolazimo i na teren.</p>
      <address class="mt-3 flex flex-col gap-1 not-italic text-ink-2">
        <span class="font-semibold text-ink">Timis Digital d.o.o.</span>
        <span>Ivanićgradska ulica 33, 10310 Ivanić-Grad</span>
        <a href="tel:+385915882884">091 588 2884</a>
        <a href="mailto:igor@timis.digital">igor@timis.digital</a>
      </address>
    </div>
    <div class="lg:col-span-7"><ContactForm paket={paket} /></div>
  </section>
</Base>
