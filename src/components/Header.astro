---
import Logo from './Logo.astro';
const nav = [
  { href: '/paketi', label: 'Paketi i cijene' },
  { href: '/vodic', label: 'Vodič za obrtnike' },
  { href: '/pitanja', label: 'Pitanja' },
  { href: '/knjigovodje', label: 'Za knjigovođe' },
];
const path = Astro.url.pathname;
---
<header class="border-b border-line bg-paper">
  <div class="container-x flex h-[76px] items-center justify-between">
    <a href="/" class="no-underline" aria-label="Moja Cijena, početna"><Logo size={34} /></a>
    <nav class="hidden items-center gap-8 text-[16px] font-medium md:flex" aria-label="Glavna navigacija">
      {nav.map((n) => (
        <a href={n.href} class={`text-ink no-underline hover:text-accent ${path.startsWith(n.href) ? 'text-accent' : ''}`}>{n.label}</a>
      ))}
      <a href="/kontakt" class="btn-primary !px-5 !py-2.5">Zatražite ponudu</a>
    </nav>
    <details class="relative md:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md" aria-label="Izbornik">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </summary>
      <div class="absolute right-0 top-12 z-20 flex w-64 flex-col gap-1 rounded-lg border border-line bg-white p-2 shadow-lg">
        {nav.map((n) => <a href={n.href} class="rounded-md px-3 py-2.5 text-ink no-underline hover:bg-paper">{n.label}</a>)}
        <a href="/kontakt" class="btn-primary mt-1">Zatražite ponudu</a>
      </div>
    </details>
  </div>
</header>
