---
interface Props { size?: number; class?: string }
const { size = 32, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg width={size} height={size} viewBox="0 0 36 36" fill="none" aria-hidden="true">
    <rect x="4" y="3" width="24" height="30" rx="4" stroke="currentColor" stroke-width="2.4" class="text-accent"/>
    <path d="M10 12h12M10 18h12M10 24h7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" class="text-accent"/>
    <circle cx="26" cy="26" r="6" fill="currentColor" class="text-accent"/>
    <path d="M23.5 26l1.8 1.8L29 24.5" stroke="#f4f1ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="font-serif font-semibold text-ink" style={`font-size:${Math.round(size * 0.66)}px`}>Moja Cijena</span>
</span>
